MCQ_ACCESS_CODE=
# true when served over HTTPS; false for local HTTP tests.
COOKIE_SECURE=false
# Per-server daily attempted page calls (UTC), including failed requests.
OCR_DAILY_LIMIT=200
MCQ_BIND_ADDRESS=127.0.0.1
MCQ_PORT=8080
